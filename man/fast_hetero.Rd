\examples{
set.seed(4)
tree <- ape::rtree(80)
x <- setNames(rnorm(80), tree$tip.label)
fit <- fast_hetero(tree, x, min_tips = 10, max_tips = 30,
                   test = TRUE, nsim = 19, progress = FALSE)
fit$clades
fit$heterogeneity
}
